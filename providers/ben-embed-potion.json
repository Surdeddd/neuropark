{
  "id": "ben-embed-potion",
  "capability": "embed",
  "kind": "model",
  "rank": 10,
  "detect": {
    "files": ["~/scripts/ben-embed.py"],
    "bin": "jq"
  },
  "io": { "in": ["text"], "out": "json" },
  "run": "jq -Rs '[.]' {in} | python3 ~/scripts/ben-embed.py > {out}",
  "timeout_s": 300,
  "notes": "potion-multilingual-128M, офлайн. контракт: stdin — JSON-массив строк, stdout — массив векторов"
}
