{
  "id": "ffmpeg-compose",
  "capability": "compose",
  "kind": "tool",
  "rank": 10,
  "detect": { "bin": "ffmpeg" },
  "io": { "in": ["video"], "out": "video" },
  "run": "ffmpeg -nostdin -y -i {in} -i {extra0} -c:v copy -map 0:v:0 -map 1:a:0 -shortest {out}",
  "timeout_s": 1800,
  "notes": "подмена звуковой дорожки: видео из основного входа, звук из --extra, видеопоток не перекодируется"
}
