{
  "id": "gen-image-gpt",
  "capability": "image",
  "kind": "model",
  "rank": 10,
  "detect": {
    "files": ["~/scripts/gen-image.py"],
    "bin": "codex"
  },
  "io": { "in": ["text"], "out": "image" },
  "run": "python3 ~/scripts/gen-image.py generate --provider chatgpt --prompt \"$(cat {in})\" --out {out}",
  "timeout_s": 600,
  "quota_patterns": ["usage limit", "rate limit", "quota"],
  "notes": "gpt-image-2 через Codex OAuth, без API-ключа. primary для любых картинок"
}
